# ============ AlgoAgent 环境变量样例（任务 10） ============
# 用法：cp .env.example .env 后按需修改；docker run 用 --env-file .env 注入

# 【必填】JWT 签名密钥；缺失时后端启动即报错退出（fail-fast）
# 生成一段随机串：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ---- 默认模型初始配置（可选；也可部署后在管理端"模型配置"页运行时修改） ----
# 对话选"默认模型"时使用；管理端内置模型/用户自定义模型不受这三项影响
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 【建议填写】对外访问地址：分享链接/二维码使用它拼 URL（不填则分享链接是 127.0.0.1 不可用）
# 公网部署示例：http://YOUR_EIP 或 https://your-domain
PUBLIC_BASE_URL=http://localhost

# ---- 数据目录（容器内路径，一般不改）----
# SQLite 数据库 + 生成页面 + 运行时配置都在 /data 卷，docker -v algoagent_data:/data 持久化
# ALGOAGENT_DATA_DIR=/data
# ALGOAGENT_PAGES_DIR=/data/pages

# ---- 可选调优（默认即可）----
# LLM_TIMEOUT=600
# LLM_MAX_TOKENS=16384